generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethodType {
  CARD
  CASH_TRANSFER
}

enum RecurringKind {
  SPEND
  INCOME
}

enum RecurringCadence {
  WEEKLY
  MONTHLY
}

model Transaction {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  merchant        String?
  grossCents      Int
  discountCents   Int            @default(0)
  netCents        Int
  notes           String?
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  tags            TransactionTag[]
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([date])
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([recurringRuleId])
}

model IncomeEvent {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  description  String
  costCents    Int        @default(0)
  revenueCents Int        @default(0)
  cardId       String?
  card         Card?      @relation(fields: [cardId], references: [id])
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([date])
  @@index([cardId])
  @@index([recurringRuleId])
}

model Category {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  parentId      String?
  parent        Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]  @relation("CategoryHierarchy")
  transactions  Transaction[]
  recurringRules RecurringRule[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Card {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  imageKey       String?
  colorHex       String?
  minSpendCents  Int?
  paymentMethods PaymentMethod[]
  incomeEvents   IncomeEvent[]
  recurringRules RecurringRule[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model PaymentMethod {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         PaymentMethodType @default(CARD)
  cardId       String?
  card         Card?             @relation(fields: [cardId], references: [id])
  transactions Transaction[]
  recurringRules RecurringRule[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([type])
  @@index([cardId])
}

model Tag {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  tags   TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TransactionTag {
  transactionId String
  tagId         String
  createdAt     DateTime   @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  transactions   Transaction[]
  incomeEvents   IncomeEvent[]
  categories     Category[]
  cards          Card[]
  paymentMethods PaymentMethod[]
  tags           Tag[]
  recurringRules       RecurringRule[]
  recurringOccurrences RecurringOccurrence[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RecurringRule {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        RecurringKind
  cadence     RecurringCadence
  dayOfMonth  Int? // 1-31 for MONTHLY (clamped to the month's length)
  dayOfWeek   Int? // 0 (Sun) - 6 (Sat) for WEEKLY
  startDate   DateTime
  endDate     DateTime? // null = indefinite
  active      Boolean          @default(true) // false = paused
  autoConfirm Boolean          @default(false)
  lastGeneratedDate DateTime? // last occurrence date already processed

  // Spend payload
  merchant        String?
  grossCents      Int?
  discountCents   Int?
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  tagIds          String[]

  // Income payload
  description  String?
  revenueCents Int?
  costCents    Int?
  cardId       String?
  card         Card?    @relation(fields: [cardId], references: [id])

  occurrences  RecurringOccurrence[]
  transactions Transaction[]
  incomeEvents IncomeEvent[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([cardId])
}

model RecurringOccurrence {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId    String
  rule      RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  createdAt DateTime      @default(now())

  @@unique([ruleId, dueDate])
  @@index([userId])
}
